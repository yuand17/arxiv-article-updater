APP_ENV=development
APP_SECRET_KEY=change-me-before-sharing
DATABASE_URL=sqlite:///./data/arxiv_updater.db
BASE_URL=http://127.0.0.1:8000
TIMEZONE=Asia/Shanghai
LOCAL_DEV_AUTO_LOGIN=true

# External services (optional: the site still works without them)
SERPAPI_API_KEY=
SERPAPI_MONTHLY_QUERY_BUDGET=240
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MONTHLY_TOKEN_BUDGET=5000000
SUMMARY_USER_WEEKLY_LIMIT=50
SOURCE_CACHE_DIR=data/cache
